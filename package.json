{
  "name": "chara-chhavani",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:apps": "eslint apps/mobile-chhavani apps/mobile-farmer apps/mobile-officer apps/mobile-vet",
    "lint:dashboard": "eslint apps/web-admin",
    "lint:packages": "eslint packages/api-client packages/ui-core",
    "lint:backend": "dotnet format backend/CharaChhavani.sln --verify-no-changes",
    "lint:backend:fix": "dotnet format backend/CharaChhavani.sln",
    "lint:all": "npm run lint && npm run lint:backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:all": "npm run typecheck",
    "test:playwright": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "typescript": "^5.7.3"
  }
}
